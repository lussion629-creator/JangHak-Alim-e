# 복사해서 .env 로 쓰세요. .env 는 .gitignore 에 있어 GitHub 에 올라가지 않습니다.
# GitHub Actions 에서는 Settings → Secrets and variables → Actions 에 같은 이름으로 등록합니다.
ADMIN_TOKEN=여기에-24자-이상-무작위-문자열      # 관리 기능(수동 갱신, HY-in 업로드). 비우면 관리 기능 꺼짐
GOV24_API_KEY=                                   # (선택) 정부24 공공서비스 API 인증키
REFRESH_HOURS=6
PII_DENYLIST=                                    # 데이터에 절대 들어가면 안 되는 개인 식별 문자열(이름, 학번 등) — 쉼표로 구분
KEYSTORE_PASS=                                   # APK 서명 키 비밀번호 (로컬 빌드 전용)
